  "clauses": [
    {
      "id": "NGC-C01",
      "pillarId": "NGP-P01",
      "text": "利用者の業務価値へ接続する"
    },
    {
      "id": "NGC-C02",
      "pillarId": "NGP-P01",
      "text": "編集・出典・鮮度・関連性品質を守る"
    },
    {
      "id": "NGC-C03",
      "pillarId": "NGP-P02",
      "text": "必須公開bundleの部分完了を認めない"
    },
    {
      "id": "NGC-C04",
      "pillarId": "NGP-P03",
      "text": "日次全工程を人手なしで閉じる"
    },
    {
      "id": "NGC-C05",
      "pillarId": "NGP-P03",
      "text": "repair-firstで同日公開成果を守る"
    },
    {
      "id": "NGC-C06",
      "pillarId": "NGP-P04",
      "text": "危険・secret・破壊・public regressionをfail-closedにする"
    },
    {
      "id": "NGC-C07",
      "pillarId": "NGP-P04",
      "text": "scheduled/recovery/public/readiness/audit/externalを分離する"
    },
    {
      "id": "NGC-C08",
      "pillarId": "NGP-P05",
      "text": "checkpointと因果retryで再生成を防ぐ"
    },
    {
      "id": "NGC-C09",
      "pillarId": "NGP-P04",
      "text": "immutable generationとsingle writerを守る"
    },
    {
      "id": "NGC-C10",
      "pillarId": "NGP-P04",
      "text": "登録済み復旧だけを実行する"
    },
    {
      "id": "NGC-C11",
      "pillarId": "NGP-P05",
      "text": "noFocusTheft・noAutoOpen・noMonitoring・即時停止を守る"
    },
    {
      "id": "NGC-C12",
      "pillarId": "NGP-P05",
      "text": "Sol/Luna/local toolをentropyに応じて配置する"
    },
    {
      "id": "NGC-C13",
      "pillarId": "NGP-P06",
      "text": "commit/push/install/runtime/task/rollbackを閉じる"
    },
    {
      "id": "NGC-C14",
      "pillarId": "NGP-P06",
      "text": "全active仕様を憲法へ結び、憲法改変をユーザーだけに限定する"
    }
  ],
