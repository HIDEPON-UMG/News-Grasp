{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "News-Grasp reporter records",
  "type": "object",
  "additionalProperties": false,
  "required": ["category", "issue_date", "records", "search_audit"],
  "properties": {
    "category": { "type": "string", "minLength": 1 },
    "issue_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "search_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_file", "dedup_file", "source_policy"],
      "properties": {
        "candidate_file": { "type": "string", "minLength": 1 },
        "dedup_file": { "type": "string", "minLength": 1 },
        "source_policy": { "type": "string", "enum": ["stage0_stage1_only"] }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "genre", "title", "title_ja", "url", "source", "summary", "bullets"],
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "genre": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "title_ja": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https?://" },
          "source": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "bullets": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
