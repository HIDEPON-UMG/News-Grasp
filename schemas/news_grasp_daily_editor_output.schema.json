{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "News-Grasp daily editor materialization output",
  "type": "object",
  "additionalProperties": false,
  "required": ["issue_date", "inputs", "append_records", "summary_markdown"],
  "properties": {
    "issue_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "inputs": {"type": "object", "additionalProperties": false, "required": [], "properties": {}},
    "append_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "genre", "title", "title_ja", "url", "source", "thumb", "summary", "bullets", "published_date", "date_evidence_source", "seen_at"],
        "properties": {
          "date": {"type": "string"},
          "genre": {"type": "string"},
          "title": {"type": "string", "minLength": 1},
          "title_ja": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https?://"},
          "source": {"type": "string", "minLength": 1},
          "thumb": {"type": "string", "pattern": "^https?://"},
          "summary": {"type": "string", "minLength": 1},
          "bullets": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "published_date": {"type": "string"},
          "date_evidence_source": {"type": "string", "minLength": 1},
          "seen_at": {"type": "string", "minLength": 1}
        }
      }
    },
    "summary_markdown": {"type": "string", "minLength": 200}
  }
}
