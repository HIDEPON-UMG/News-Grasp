{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "News-Grasp editor summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["issue_date", "inputs", "append_records", "summary_markdown"],
  "properties": {
    "issue_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reporter_artifacts", "dedup_file", "source_policy"],
      "properties": {
        "reporter_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "dedup_file": { "type": "string", "minLength": 1 },
        "source_policy": { "type": "string", "enum": ["no_recollection"] }
      }
    },
    "append_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "genre", "title", "title_ja", "url", "source", "summary", "bullets"],
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "genre": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "title_ja": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https?://" },
          "source": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "bullets": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "summary_markdown": { "type": "string", "minLength": 1 }
  }
}
