{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "News-Grasp reporter fan-out compact return",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "category",
    "issue_date",
    "records_file",
    "digest_file",
    "search_audit",
    "selected_count",
    "titles",
    "quality_shortfall_reasons"
  ],
  "properties": {
    "category": { "type": "string", "minLength": 1 },
    "issue_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "records_file": { "type": "string", "minLength": 1 },
    "digest_file": { "type": "string", "minLength": 1 },
    "search_audit": { "type": "string", "minLength": 1 },
    "selected_count": { "type": "integer", "minimum": 1, "maximum": 5 },
    "titles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "quality_shortfall_reasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
